# Copia in .env per lo sviluppo locale. Non committare il file .env.
PORT=3000
BASE_URL=http://localhost:3000
DATABASE_URL=postgres://postgres:dev@localhost:5432/contracts
SESSION_SECRET=stringa-casuale-di-almeno-48-caratteri
SESSION_HOURS=10
REQUIRE_TOTP_FOR_ADMINS=false
MAX_UPLOAD_MB=25
MAX_PACK_MB=600

# Primo amministratore (creato al primo avvio se non esiste; password temporanea da cambiare al primo accesso)
SEED_ADMIN_EMAIL=francesco.epifani@toscanadiagnostica.it
SEED_ADMIN_NAME=Francesco Epifani
SEED_ADMIN_PASSWORD=password-temporanea-min-12-caratteri

# Accesso Microsoft 365 (Entra ID). Vuoti = disattivato, restano gli account locali.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Facoltativo: sintesi automatica dei CV (CV Box)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Percorso dell'eseguibile LibreOffice (default: soffice nel PATH)
SOFFICE_BIN=soffice
